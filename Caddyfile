# Default reverse proxy (replaceable). Serves the SPA build and proxies /api → api.
# Caddy auto-provisions TLS when PUBLIC_BASE_URL is a real domain with reachable
# ports; behind a tunnel it serves plain HTTP locally (TLS terminated upstream).
{$PUBLIC_BASE_URL} {
	encode zstd gzip

	# API
	handle /api/* {
		reverse_proxy api:3000
	}

	# SPA (history fallback to index.html)
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self'"
	}
}
