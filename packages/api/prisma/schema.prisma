// Prisma schema — a faithful second copy of the DDL contract (spec/schema/*).
// When the two would diverge, the contract wins; `npm run check:schema` guards it.
// PG extensions (unaccent, pg_trgm), GIN trigram indexes, and the connect-pg-simple
// session table live in migration SQL, not here (docs/architecture/testing.md §5).
//
// M0 implements the `app_user` table only; later milestones add the rest.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Authenticated account. username is stored lower-cased; the plain unique index
/// implements the contract's case-insensitive uniqueness (CHECKs live in SQL).
model AppUser {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username     String   @unique
  passwordHash String   @map("password_hash")
  sex          String
  birthdate    DateTime @db.Date
  heightCm     Decimal  @map("height_cm") @db.Decimal
  settings     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("app_user")
}

/// Catalog food (spec/schema/tables-catalog.md → food). Per-100 g macros; soft
/// delete via archived_at. `normalized_name` is the unaccent+lower search key,
/// maintained by domain/search/normalize.ts on write. Relations (owner_id → app_user,
/// recipe_id → recipe) are enforced by FKs in migration SQL, not Prisma relations,
/// so the column-faithful schema stays in step with the DDL contract gate. The
/// recipe FK is added in M5 when the recipe table exists.
model Food {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId        String    @map("owner_id") @db.Uuid
  name           String
  normalizedName String    @map("normalized_name")
  kcalPer100g    Decimal   @map("kcal_per_100g") @db.Decimal
  fatPer100g     Decimal   @map("fat_per_100g") @db.Decimal
  carbPer100g    Decimal   @map("carb_per_100g") @db.Decimal
  proteinPer100g Decimal   @map("protein_per_100g") @db.Decimal
  comment        String?
  rating         Int?      @db.SmallInt
  visibility     String    @default("private")
  source         String    @default("manual")
  recipeId       String?   @map("recipe_id") @db.Uuid
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz()
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("food")
}

/// Named portion of a food (spec/schema/tables-catalog.md → food_portion). The
/// food_id FK (ON DELETE CASCADE) and UNIQUE(food_id,label) live in migration SQL.
model FoodPortion {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  foodId    String   @map("food_id") @db.Uuid
  label     String
  grams     Decimal  @db.Decimal
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("food_portion")
}

/// Recipe (spec/schema/tables-catalog.md → recipe). Assembles ingredients (foods or
/// other recipes) into a derived food. Per-100 g & per-portion macros are NOT stored
/// here — they live on the derived `food` row (source='recipe', food.recipe_id → this).
/// `total_batch_grams` defaults to Σ ingredient grams but is overridable to the measured
/// cooked weight. Soft delete via archived_at (history of meals that logged it is frozen).
/// CHECKs (servings ≥ 1, total_batch_grams > 0, rating ∈ 0..3) and the owner FK live in
/// migration SQL. `rating`: null=unrated, else a 0..3 grade (mirrors food.rating, Gap #7).
model Recipe {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId         String    @map("owner_id") @db.Uuid
  name            String
  normalizedName  String    @map("normalized_name")
  instructions    String?
  totalBatchGrams Decimal   @map("total_batch_grams") @db.Decimal
  servings        Int       @default(1)
  rating          Int?      @db.SmallInt
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz()
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("recipe")
}

/// A recipe ingredient (spec/schema/tables-catalog.md → recipe_ingredient). References a
/// food OR another recipe (ref_type + the matching ref_*_id; XOR enforced by CHECK in
/// migration SQL). `quantity`+`unit` resolve to grams (portion_id set when unit='portion').
/// No timestamps in the contract. The recipe FK (ON DELETE CASCADE), the XOR CHECK and the
/// `ref_recipe_id <> recipe_id` self-ref CHECK all live in migration SQL.
model RecipeIngredient {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipeId     String  @map("recipe_id") @db.Uuid
  refType      String  @map("ref_type")
  refFoodId    String? @map("ref_food_id") @db.Uuid
  refRecipeId  String? @map("ref_recipe_id") @db.Uuid
  quantity     Decimal @db.Decimal
  unit         String
  portionId    String? @map("portion_id") @db.Uuid
  orderIndex   Int     @map("order_index")

  @@map("recipe_ingredient")
}

/// Manual calorie/macro target (spec/schema/tables-weight-targets.md → target).
/// Carbs are never stored (derived remainder); the gram floors/ceiling are computed
/// on current weight, not persisted here. Saving inserts a new row per effective_from
/// (history). CHECKs, UNIQUE(user_id,effective_from) and the owner FK live in
/// migration SQL (column-faithful schema mirrors the DDL contract gate).
model Target {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  calorieMin     Int      @map("calorie_min")
  calorieMax     Int      @map("calorie_max")
  proteinGPerKg  Decimal  @map("protein_g_per_kg") @db.Decimal
  fatGPerKg      Decimal  @map("fat_g_per_kg") @db.Decimal
  targetWeightKg Decimal? @map("target_weight_kg") @db.Decimal
  rateKgPerWeek  Decimal? @map("rate_kg_per_week") @db.Decimal
  effectiveFrom  DateTime @map("effective_from") @db.Date
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([userId, effectiveFrom])
  @@map("target")
}

/// Tare container (spec/schema/tables-catalog.md → container). Leftover proration
/// reads it to freeze container_name + tare_g at apply time; deleting the catalog row
/// never affects frozen history (OPEN_GAPS #13). M3 adds the table + a read-only repo
/// for the leftover endpoint and seeds the locked built-in "Rien" (0 g); the full
/// Contenants CRUD/screen is built in M7. CHECKs, UNIQUE(owner_id,normalized_name) and
/// the owner FK live in migration SQL (column-faithful schema mirrors the DDL gate).
model Container {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId        String   @map("owner_id") @db.Uuid
  name           String
  normalizedName String   @map("normalized_name")
  emptyWeightG   Decimal  @map("empty_weight_g") @db.Decimal
  isBuiltin      Boolean  @default(false) @map("is_builtin")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([ownerId, normalizedName])
  @@map("container")
}

/// Body weigh-in (spec/schema/tables-weight-targets.md → weight_entry). Consecutive
/// entries define variable-length periods; per-period stats are derived, not stored.
/// Introduced in M2 so the metabolic engine can read the current weight; the periods,
/// EMA, trajectory and Weight screen are built on this table in M4. CHECKs,
/// UNIQUE(user_id,date) and the owner FK live in migration SQL.
model WeightEntry {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  date      DateTime @db.Date
  weightKg  Decimal  @map("weight_kg") @db.Decimal
  waistCm   Decimal? @map("waist_cm") @db.Decimal
  dietFlag  String   @map("diet_flag")
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([userId, date])
  @@map("weight_entry")
}

/// The user's default day structure (spec/schema/tables-logging.md → meal_slot_template).
/// Edited in Paramètres; seeds the meals of each new day (the per-day meals are then
/// independent — editing a day never edits this template). Seeded with the default slots
/// on user creation (services/user-bootstrap.ts). The owner FK and UNIQUE(user_id,name)
/// live in migration SQL (column-faithful schema mirrors the DDL gate).
model MealSlotTemplate {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  name       String
  orderIndex Int      @map("order_index")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([userId, name])
  @@map("meal_slot_template")
}

/// A garde-manger pin (spec/schema/tables-logging.md → pantry_item). Recurring foods
/// auto-prefilled at quantity 0 on every new day's matching meal slot. Same data as the
/// Repas 📌 toggle and the Paramètres per-meal editor; unpinning affects FUTURE-day prefill
/// only (OPEN_GAPS #8). A pin on an archived food is retained but not prefilled. The owner
/// FK, the food FK, and UNIQUE(user_id,meal_slot_name,food_id) live in migration SQL.
model PantryItem {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  mealSlotName String   @map("meal_slot_name")
  foodId       String   @map("food_id") @db.Uuid
  unit         String   @default("g")
  portionId    String?  @map("portion_id") @db.Uuid
  orderIndex   Int      @map("order_index")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([userId, mealSlotName, foodId])
  @@map("pantry_item")
}

/// One logged calendar day (spec/schema/tables-logging.md → day_log). Created lazily
/// on first interaction. `target_snapshot` freezes that date's effective calorie range
/// + macro thresholds (OPEN_GAPS #1): live while date==today, frozen once date<today.
/// `verdict_auto` is calorie-only and persisted (cache); the source of truth is the
/// computation. CHECKs (kind, summary⇔summary_kcal, verdict IN), UNIQUE(user_id,date)
/// and the owner FK live in migration SQL.
model DayLog {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  date            DateTime @db.Date
  kind            String
  summaryKcal     Decimal? @map("summary_kcal") @db.Decimal
  activityLevel   String   @default("sedentary") @map("activity_level")
  comment         String?
  verdictAuto     String?  @map("verdict_auto")
  verdictOverride String?  @map("verdict_override")
  targetSnapshot  Json     @map("target_snapshot")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([userId, date])
  @@map("day_log")
}

/// A meal slot of one day (spec/schema/tables-logging.md → meal). Seeded from the
/// template on day creation but per-day editable; editing it never edits the template.
/// Only on detailed days. The day_log FK (ON DELETE CASCADE) lives in migration SQL.
model Meal {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dayLogId  String   @map("day_log_id") @db.Uuid
  slotName  String   @map("slot_name")
  orderIndex Int     @map("order_index")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("meal")
}

/// A logged food line (spec/schema/tables-logging.md → meal_entry). Stores the served
/// quantity + a macro snapshot frozen at write time (history immune to later food/
/// recipe edits). Consumed grams & scaled macros are derived = snapshot × consumed/
/// served (leftover-proration.md). The garde-manger pin is NOT stored per line: it is
/// derived live from pantry_item on read (spec/logic/pantry-pin.md, B-045). The
/// XOR(referenced⇔food_id, custom⇔custom_name), CHECKs and the meal FK (ON DELETE
/// CASCADE) live in migration SQL.
model MealEntry {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mealId          String   @map("meal_id") @db.Uuid
  kind            String
  foodId          String?  @map("food_id") @db.Uuid
  customName      String?  @map("custom_name")
  servedQuantity  Decimal  @default(0) @map("served_quantity") @db.Decimal
  unit            String
  portionId       String?  @map("portion_id") @db.Uuid
  servedGrams     Decimal? @map("served_grams") @db.Decimal
  snapKcal        Decimal  @map("snap_kcal") @db.Decimal
  snapFat         Decimal  @map("snap_fat") @db.Decimal
  snapCarb        Decimal  @map("snap_carb") @db.Decimal
  snapProtein     Decimal  @map("snap_protein") @db.Decimal
  orderIndex      Int      @map("order_index")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("meal_entry")
}

/// A shared-plate leftover group (spec/schema/tables-logging.md → leftover_group). The
/// container is frozen as a value (container_name + tare_g), NOT a FK, so editing/
/// deleting the catalog container never alters history (OPEN_GAPS #13). Re-editable.
/// CHECKs (tare_g/gross_grams ≥ 0) and the meal FK (ON DELETE CASCADE) live in SQL.
model LeftoverGroup {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mealId        String   @map("meal_id") @db.Uuid
  containerName String   @map("container_name")
  tareG         Decimal  @map("tare_g") @db.Decimal
  grossGrams    Decimal  @map("gross_grams") @db.Decimal
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("leftover_group")
}

/// The prorated subset of entries in a leftover group (spec/schema/tables-logging.md →
/// leftover_group_entry). Composite PK; both FKs ON DELETE CASCADE (migration SQL). An
/// entry belongs to at most one group per meal (enforced in app).
model LeftoverGroupEntry {
  leftoverGroupId String @map("leftover_group_id") @db.Uuid
  mealEntryId     String @map("meal_entry_id") @db.Uuid

  @@id([leftoverGroupId, mealEntryId])
  @@map("leftover_group_entry")
}
