{
  "name": "macronome",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "npm run dev -w @macronome/api",
    "dev:web": "npm run dev -w @macronome/web",
    "build": "npm run build -w @macronome/shared && npm run build -w @macronome/api && npm run build -w @macronome/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:int": "npm run test:int -w @macronome/api",
    "e2e": "playwright test",
    "db:dev": "docker compose -f compose.test.yml up -d",
    "migrate": "npm run prisma:deploy -w @macronome/api",
    "check:schema": "node scripts/check-schema.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^3.0.0"
  }
}
