# Production env for compose.yml (ADR-0001). In Portainer, set these as stack env vars.

# --- image & host ---
MACRONOME_TAG=latest                 # image tag to deploy (latest, or vX.Y.Z)
APP_PORT=3000                        # host port mapped to the app
DATA_PATH=./data                     # host path where Postgres data is stored

# --- database (DATABASE_URL is derived from these in compose.yml) ---
POSTGRES_DB=macronome
POSTGRES_USER=macronome
POSTGRES_PASSWORD=

# --- app ---
SESSION_SECRET=                      # long random string
TRUSTED_PROXY=loopback               # set to your front proxy's address/CIDR when fronted
PUBLIC_BASE_URL=https://macronome.example.org
COOKIE_SECURE=true                   # set false only for plain-HTTP local testing
NODE_ENV=production

# --- reserved (unused in v1) ---
LLM_ENDPOINT_URL=
LLM_ENDPOINT_KEY=
