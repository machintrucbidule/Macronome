# Macronome runs with ZERO configuration (ADR-0001): `docker compose up -d` works with
# no .env at all. Everything below is OPTIONAL — copy to `.env` and uncomment only what
# you want to override. In Portainer, set any of these as stack env vars if needed.

# --- image & host ---
# MACRONOME_TAG=latest        # image tag to deploy (latest, or vX.Y.Z)
# APP_PORT=3000               # host port mapped to the app
# (data lives in Docker-managed named volumes — nothing to configure here)

# --- database (internal only, not exposed; defaults are fine) ---
# POSTGRES_DB=macronome
# POSTGRES_USER=macronome
# POSTGRES_PASSWORD=macronome

# --- app ---
# SESSION_SECRET=             # leave unset: auto-generated & persisted on first boot
# COOKIE_SECURE=false         # safe to set true behind an HTTPS proxy (TRUSTED_PROXY must cover it)
# TRUSTED_PROXY=loopback, uniquelocal  # peers trusted for X-Forwarded-* (Secure cookies + real
#                             # client IP in login rate-limiting). Default trusts loopback + private/
#                             # container ranges (covers a Docker sidecar proxy / tunnel). Narrow to
#                             # `loopback` (same-host only) or a specific CIDR to tighten.
# PUBLIC_ORIGIN=              # public HTTPS origin for the Google Drive OAuth callback when
#                             # fronted (e.g. https://macronome.example.com). Optional; only
#                             # needed for the Drive backup behind a reverse proxy / tunnel.

# --- reserved (unused in v1) ---
# LLM_ENDPOINT_URL=
# LLM_ENDPOINT_KEY=
